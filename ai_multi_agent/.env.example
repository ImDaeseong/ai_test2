# OpenRouter API key from https://openrouter.ai/keys
# Place this file in the ai_multi_agent/ folder or the parent workspace folder.
OPENROUTER_API_KEY=sk-or-...

# Optional OpenAI image generation key for MV image creation.
# If this is missing, the MV page can still show/copy prompts but cannot generate images.
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1536x1024

# Model override. See https://openrouter.ai/models
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
# OPENROUTER_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_MODEL=openai/gpt-4o

# Optional project roots. Relative paths are resolved from the workspace root,
# which is the parent folder of ai_multi_agent.
# Defaults:
# HERMES_ROOT=ai_img_video_prompt
# STORY_ROOT=ai_story
# SCENARIO_ROOT=ai_Scenario
# ANIME_ROOT=ai_anime
#
# These defaults assume the project folders are siblings of ai_multi_agent's
# own parent folder. If your ai_story / ai_Scenario / etc. projects actually
# live elsewhere (e.g. under a different workspace folder), set the *_ROOT
# variables to point there - otherwise the story/scenario web UI will show
# an empty project list. As of 2026-07-13 the story/scenario web UI surfaces
# this as a visible warning (instead of a silent empty list) when the
# configured folder does not exist, so check that message first if projects
# aren't showing up.
# STORY_ROOT=../ai_test1/ai_story
# SCENARIO_ROOT=../ai_test1/ai_Scenario
