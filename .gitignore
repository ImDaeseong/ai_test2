# Source-only public distribution: keep media and compiled programs local.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.mp3
*.wav
*.mp4
*.exe
*.ico
*.svg
*.flac
*.lrc
*.srt
*.ncb
*.suo
*.aps

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/

# music_insight_studio runtime artifacts
music_insight_studio/uploads/
music_insight_studio/outputs/

# CareerDiff app runtime storage (data/<UUID>.json + data/profiles/<hash>.json) — contains
# real job posting text and candidate profile fields entered through the running app, not
# fixtures (moved from ai_test3 .gitignore, which excluded these for the same reason)
CareerDiff/data/**/*.json

# Tests
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/

# Environment / Secrets
.env
*.env.local

# Generated outputs (runtime artifacts — not source)
output/
output_raw/

# User-provided songs, lyrics, and editing clips
ai_anime/input/*
!ai_anime/input/.gitkeep
ai_img_video_aiBoygirl/input/*
!ai_img_video_aiBoygirl/input/.gitkeep
ai_img_video_prompt_capcut/input/*
!ai_img_video_prompt_capcut/input/.gitkeep

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# Windows batch temp
*.tmp
