# 공통: 실제 값은 .env가 아니라 운영 환경변수나 비밀 저장소에 넣으세요.

# Threads
THREADS_USER_ID=your_threads_user_id
THREADS_ACCESS_TOKEN=your_threads_user_access_token

# Instagram Professional (Business 또는 Creator)
INSTAGRAM_USER_ID=your_instagram_professional_user_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_user_access_token

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=@your_channel_or_chat_id

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=your_tiktok_user_access_token

# X API
X_USER_ACCESS_TOKEN=your_x_user_access_token

# KakaoTalk 메시지 API (공개 커뮤니티 글쓰기 API가 아님)
KAKAO_ACCESS_TOKEN=your_kakao_user_access_token

# Naver Cafe 글쓰기 API
NAVER_ACCESS_TOKEN=your_naver_login_access_token
NAVER_CAFE_ID=your_cafe_numeric_id
NAVER_CAFE_MENU_ID=your_board_menu_id

# Facebook Page
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token
META_GRAPH_VERSION=v24.0

# LinkedIn Posts API
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_AUTHOR_URN=urn:li:person:your_id_or_urn:li:organization:your_id
LINKEDIN_VERSION=202610

# Discord Incoming Webhook (URL 자체가 비밀값)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_id/your_token

# Reddit OAuth
REDDIT_ACCESS_TOKEN=your_reddit_user_access_token
REDDIT_SUBREDDIT=your_subreddit_without_r_prefix

# YouTube Data API (현재 코드는 실행 HOLD 경계를 제공)
YOUTUBE_ACCESS_TOKEN=your_google_oauth_access_token
